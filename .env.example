# Copie para .env.local e preencha a chave somente nesse arquivo local.
GEMINI_API_KEY=
GEMINI_MODEL=

CHATBOT_ENABLED=true
# Limites globais da aplicação, compartilhados por todos os visitantes.
# São limites iniciais conservadores; ajustar conforme as cotas reais do projeto.
CHATBOT_REQUESTS_PER_MINUTE=5
CHATBOT_REQUESTS_PER_DAY=50

# Usar Upstash Redis no plano Free, sem contratar plano pago.
# Necessários em produção. Em npm run dev, sem estas variáveis,
# o contador é local e reinicia junto com o processo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
